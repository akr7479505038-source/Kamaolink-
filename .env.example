# GEMINI_API_KEY: Optional (automatically injected by AI Studio if needed).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://your-app.onrender.com).
# AI Studio injects this automatically at runtime.
APP_URL="MY_APP_URL"

# SESSION_SECRET: A random secret text used to sign login sessions.
# Change this to any long random string when you deploy online.
SESSION_SECRET="change-this-to-a-long-random-string"

# BANK_ENCRYPTION_KEY: 32+ character secret used to encrypt saved bank details in SQLite.
# Change this before deploying online and keep it safe.
BANK_ENCRYPTION_KEY="change-this-to-another-very-long-random-secret-key"

# ADMIN_EMAIL & ADMIN_PASSWORD: Login credentials for the /admin payout dashboard.
# Set your own private email and strong password before going live.
ADMIN_EMAIL="akr7479505038@gmail.com"
ADMIN_PASSWORD="change-this-admin-password"

# MIN_AD_WATCH_SECONDS: Minimum seconds a visitor must watch each video ad (default: 4).
MIN_AD_WATCH_SECONDS="4"

# DEV_FALLBACK_COUNTRY: Used ONLY on localhost/private IPs where no real public IP exists.
DEV_FALLBACK_COUNTRY="IN"
